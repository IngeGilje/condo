/* Shared colors, spacing, and surface styles. Change these to update the whole UI. */
:root {
  --page: #f3f6fa;
  --surface: #fff;
  --text: #182230;
  --muted: #667085;
  --border: #d0d9e6;
  --primary: #3157d5;
  --primary-dark: #2445b7;
  --danger: #b42318;
  --radius: 12px;
  --shadow: 0 8px 28px rgb(30 50 80 / 8%);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  color: var(--text);
  background: var(--page);
}

/* Main page and reusable cards. */
.page {
  width: min(1120px, calc(100% - 32px));
  margin: 32px auto 56px;
}

.page-header {
  margin-bottom: 24px;
}

.page-header h1 {
  margin: 0 0 6px;
  font-size: 26px;
  letter-spacing: -.02em;
}

.page-header p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.card {
  margin-bottom: 20px;
  padding: 24px;
  border: 1px solid #e0e6ef;
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 20px;
  color: #344054;
  font-size: 15px;
  font-weight: 700;
}

.card-title::before {
  content: "";
  width: 4px;
  height: 18px;
  border-radius: 99px;
  background: var(--primary);
}

/* Layout grids: minmax(0, 1fr) lets long content shrink inside a column. */
.grid {
  display: grid;
  gap: 18px;
}

.grid-menu {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.grid-voucher,
.grid-form {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-voucher {
  max-width: 550px;
}

.grid-layout {
  display: grid;
  grid-template-columns: 260px minmax(0, 1fr);
  align-items: start;
  gap: 20px;
}

.grid-layout .card {
  margin-bottom: 0;
}

.field {
  position: relative;
  min-width: 0;
}

.field.wide {
  grid-column: auto;
}

.field.wide2 {
  grid-column: span 2;
}

.field.wide3 {
  grid-column: span 3;
}

/* Labels sit across the top border of each control. */
.field label {
  position: absolute;
  z-index: 1;
  top: -8px;
  left: 12px;
  padding: 0 6px;
  color: #475467;
  background: var(--surface);
  font-size: 12px;
  font-weight: 600;
}

/* Controls fill their grid cell; focus styling appears only while focused. */
input,
select,
textarea {
  font: inherit;
}

input,
select {
  display: block;
  width: 100%;
  min-width: 0;
  height: 52px;
  padding: 0 14px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--text);
  font-size: 16px;
  transition: border-color .18s, box-shadow .18s;
}

input:hover,
select:hover,
textarea:hover {
  border-color: #98a8bd;
}

input:focus-visible,
select:focus-visible,
textarea:focus-visible,
button:focus-visible {
  outline: 3px solid rgb(49 87 213 / 22%);
  outline-offset: 2px;
  border-color: var(--primary);
}

input[readonly] {
  background: #f8fafc;
  color: #475467;
}

.number {
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* Legacy field positions, used outside the responsive grids. */
.field-position {
  width: min(250px, 100%);
  margin: 0 0 15px 35px;
}

.field-position-menu {
  margin: 0 0 5px 15px;
  text-align: center;
}

/* Full-width text field; padding leaves room for its border label. */
.text-field {
  grid-column: 1 / -1;
}

.text-field textarea {
  display: block;
  width: 100%;
  min-height: 110px;
  padding: 16px 12px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--text);
  line-height: 1.5;
  resize: vertical;
}

/* Form actions and button variants. */
.actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 22px;
}

button {
  min-width: 112px;
  min-height: 44px;
  padding: 0 20px;
  border: 1px solid transparent;
  border-radius: 10px;
  font: inherit;
  font-size: 14px;
  font-weight: 650;
  cursor: pointer;
  transition: transform .15s, background .15s, border-color .15s, box-shadow .15s;
}

button:hover {
  transform: translateY(-1px);
}

.primary {
  color: #fff;
  background: var(--primary);
  box-shadow: 0 5px 14px rgb(49 87 213 / 24%);
}

.primary:hover {
  background: var(--primary-dark);
}

.secondary {
  color: #344054;
  background: #fff;
  border-color: var(--border);
}

.secondary:hover {
  background: #f8fafc;
  border-color: #98a8bd;
}

.danger {
  margin-left: auto;
  color: var(--danger);
  background: #fff;
  border-color: #f2c7c3;
}

.danger:hover {
  background: #fff5f4;
}

/* Filter panel stays visible beside the content on wider screens. */
.filter-card {
  position: sticky;
  top: 20px;
}

.filter-card .grid-voucher {
  grid-template-columns: 1fr;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 18px;
  max-width: 720px;
}

.filter-field {
  min-width: 0;
}

.filter-field label {
  display: block;
  margin-bottom: 6px;
  color: #475569;
  font-weight: 600;
}

.filter-field input,
.filter-field select {
  height: 52px;
}

/* News card: the image remains in normal document flow. */
.News-container {
  max-width: 900px;
  margin: 40px auto;
  padding: 20px;
}

.news-card {
  overflow: hidden;
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: 0 8px 20px rgb(0 0 0 / 10%);
}

.news-image img {
  display: block;
  width: 100%;
  height: auto;
}

.news-content {
  padding: 20px;
}

.news-title {
  margin: 0 0 10px;
  font-size: 1.8rem;
}

.news-meta {
  margin-bottom: 15px;
  color: var(--muted);
  font-size: .9rem;
}

.news-text {
  width: 100%;
  line-height: 1.6;
  white-space: pre-line;
}

/* Waste collection table: horizontal scrolling keeps columns readable on phones. */
.waste-page {
  width: 100%;
  max-width: 1240px;
  margin: 32px auto;
  padding: 0 20px;
}

.waste-card {
  overflow: hidden;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 8px 30px rgb(15 23 42 / 5%);
}

.waste-heading {
  padding: 24px;
  border-bottom: 1px solid #e8edf3;
}

.waste-heading h1 {
  margin: 0;
  font-size: 22px;
  font-weight: 650;
}

.waste-heading p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 14px;
}

.waste-scroll {
  overflow-x: auto;
}

.waste-scroll:focus-visible {
  outline: 3px solid rgb(49 87 213 / 22%);
  outline-offset: -3px;
}

.waste-card .transaction-table {
  width: 100%;
  min-width: 960px;
  margin: 0;
  border: 0;
  border-collapse: collapse;
  table-layout: auto;
  background: transparent;
  font-size: 14px;
}

.waste-card .transaction-table th,
.waste-card .transaction-table td {
  padding: 16px 14px;
  border: 0;
  text-align: center;
  vertical-align: middle;
  white-space: nowrap;
}

.waste-card .transaction-table thead th {
  padding-top: 15px;
  padding-bottom: 15px;
  border-bottom: 1px solid #e2e8f0;
  background: #f8fafc;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}

.waste-card .transaction-table tbody td {
  border-bottom: 1px solid #edf1f5;
}

.waste-card .transaction-table tbody tr:last-child td {
  border-bottom: 0;
}

.waste-card .transaction-table tbody tr {
  background: #fff;
  transition: background-color .15s;
}

.waste-card .transaction-table tbody tr:focus-within {
  background: #f8faff;
}

@media (hover: hover) {
  .waste-card .transaction-table tbody tr:hover {
    background: #f8faff;
  }
}

/* Table controls override the full-width form controls above. */
.waste-card .transaction-table select,
.waste-card .transaction-table input {
  display: inline-block;
  width: 120px;
  height: 40px;
  margin: 0;
  padding: 8px 10px;
  border: 1px solid #dce3ec;
  border-radius: 8px;
  background: #fff;
  color: #334155;
  text-align: center;
  box-shadow: none;
}

.waste-card .transaction-table select:disabled,
.waste-card .transaction-table input[readonly] {
  background: #f8fafc;
  color: #475569;
  opacity: 1;
  -webkit-text-fill-color: #475569;
}

.waste-card .transaction-table select:enabled {
  cursor: pointer;
}

/* Waste category icons and row edit buttons. */
.waste-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  vertical-align: middle;
}

.waste-icon .bi {
  font-size: 23px;
  line-height: 1;
}

.waste-icon--general {
  background: #eef2f6;
  color: #475569;
}

.waste-icon--paper {
  background: #eff6ff;
  color: #2563eb;
}

.waste-icon--food {
  background: #ecfdf3;
  color: #15803d;
}

.waste-icon--plastic {
  background: #f0fdfa;
  color: #0f766e;
}

.waste-card .transaction-table button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: auto;
  min-width: 108px;
  min-height: 40px;
  margin: 0;
  padding: 8px 14px;
  border: 1px solid #dbeafe;
  border-radius: 8px;
  background: #eff6ff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: none;
}

.waste-card .transaction-table button:hover {
  background: #dbeafe;
  border-color: #93c5fd;
}

.waste-card .transaction-table button:active {
  background: #bfdbfe;
}

.table-container {
  margin-left: 25px;
}

/* At medium widths, reduce columns without shrinking fields into each other. */
@media (max-width: 850px) {

  .grid-menu,
  .grid-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid-layout {
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .filter-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* On small screens, filter and form fields stack in one column. */
@media (max-width: 700px) {
  .waste-page {
    margin: 16px auto;
    padding: 0 12px;
  }

  .waste-heading {
    padding: 20px;
  }

  .waste-heading h1 {
    font-size: 20px;
  }
}

@media (max-width: 560px) {
  .page {
    width: calc(100% - 20px);
    margin-top: 18px;
  }

  .card {
    padding: 20px 16px;
  }

  .grid-menu,
  .grid-voucher,
  .grid-form,
  .grid-layout,
  .filter-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .field.wide2,
  .field.wide3 {
    grid-column: 1 / -1;
  }

  .filter-card {
    position: static;
  }

  .field-position {
    margin-left: 0;
  }

  .actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .actions button {
    width: 100%;
    min-width: 0;
  }

  .danger {
    margin-left: 0;
  }

  .table-container {
    margin-left: 0;
  }
}